#version 450
#extension GL_GOOGLE_include_directive : require
// out[q][cols] = y[q][rows] @ W, one output column per invocation.

layout(local_size_x = 64) in;

layout(std430, binding = 0) writeonly buffer Out { float o[]; };
layout(std430, binding = 1) readonly buffer Y { float y[]; };
layout(std430, binding = 2) readonly buffer W { uint w[]; };
layout(push_constant) uniform P { uint q; uint rows; uint cols; } p;

#include "weights.glsl"

void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint j = gl_GlobalInvocationID.y;
    if (c >= p.cols || j >= p.q) return;
    float acc = 0.0;
    for (uint r = 0; r < p.rows; ++r) {
        const float yr = y[j * p.rows + r];
        if (yr != 0.0) acc = fma(yr, load_w(r * p.cols + c), acc);
    }
    o[j * p.cols + c] = acc;
}
