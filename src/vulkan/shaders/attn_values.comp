#version 450
// out[j] = sum_p scores[p] * v[p * stride + j]

layout(local_size_x = 64) in;

layout(std430, binding = 0) writeonly buffer Out { float o[]; };
layout(std430, binding = 1) readonly buffer S { float scores[]; };
layout(std430, binding = 2) readonly buffer V { float v[]; };
layout(push_constant) uniform P { uint keys; uint vd; uint stride; } p;

void main() {
    const uint g = gl_GlobalInvocationID.x;
    if (g >= p.vd) return;
    float acc = 0.0;
    for (uint i = 0; i < p.keys; ++i) acc = fma(scores[i], v[i * p.stride + g], acc);
    o[g] = acc;
}
